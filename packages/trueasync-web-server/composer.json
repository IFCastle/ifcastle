{
    "name": "ifcastle/trueasync-web-server",
    "description": "IfCastle web server on TrueAsync\\HttpServer.",
    "type": "ifcastle-engine",
    "license": "MIT",
    "keywords": ["web-server", "ifcastle", "trueasync", "http"],
    "extra": {
        "ifcastle-installer": {
            "package": {
                "name": "trueasync_web_server",
                "mainConfig": {
                    "server": {
                        "comment": "Web server on TrueAsync\\HttpServer: host and port to listen on.",
                        "config": {
                            "host": "127.0.0.1",
                            "port": 9095
                        }
                    }
                },
                "bootloaders": [
                    "IfCastle\\TrueAsyncWebServer\\Bootloader"
                ],
                "applications": [
                    "server"
                ]
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "IfCastle\\TrueAsyncWebServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IfCastle\\TrueAsyncWebServer\\": "./tests"
        }
    },
    "require": {
        "php": ">=8.6",
        "ext-true_async": "*",
        "ext-true_async_server": ">=0.16.0",
        "ifcastle/application": "^0.8",
        "ifcastle/async-contracts": "^0.5",
        "ifcastle/protocol-contracts": "^0.7",
        "ifcastle/trueasync-engine": "^0.1",
        "league/uri": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "ifcastle/codestyle": "^0.1"
    }
}
