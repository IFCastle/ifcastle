{
    "name": "ifcastle/trueasync-engine",
    "description": "TrueAsync Engine for IfCastle Application.",
    "type": "ifcastle-engine",
    "license": "MIT",
    "keywords": ["engine", "ifcastle", "trueasync", "async", "coroutines"],
    "extra": {
        "ifcastle-installer": {
            "package": {
                "name": "trueasync_engine",
                "bootloaders": [
                    "IfCastle\\TrueAsync\\Bootloader"
                ]
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "IfCastle\\TrueAsync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IfCastle\\TrueAsync\\": "./tests"
        }
    },
    "require": {
        "php": ">=8.6",
        "ext-true_async": "*",
        "ifcastle/application": "^0.8",
        "ifcastle/async-contracts": "^0.5",
        "ifcastle/exceptions": "^5.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "ifcastle/codestyle": "^0.1"
    }
}
