{
    "name": "ifcastle/mcp",
    "description": "A stateless Model Context Protocol server over HTTP: both protocol eras, a tool registry and a bearer check.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ifcastle",
        "mcp",
        "model context protocol"
    ],
    "autoload": {
        "psr-4": {
            "IfCastle\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IfCastle\\Mcp\\": "./tests"
        }
    },
    "require": {
        "php": ">=8.5",
        "ifcastle/protocol-contracts": "^0.7",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "ifcastle/codestyle": "^0.1",
        "phpstan/phpstan": "^2.1"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
